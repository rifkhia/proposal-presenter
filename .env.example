# Copy to .env and adjust as needed.

# Host port the app is published on. Behind the host nginx for HTTPS (nginx-vm.conf),
# use 127.0.0.1:8080 so the app is only reachable through HTTPS.
APP_PORT=8080

# Host folder containing the proposal .md files.
PROPOSALS_PATH=./proposals

# Editor password, as a hash (never the password itself). Leave empty to disable editing.
# Generate it with:  docker compose run --rm backend python -m app.hashpw
EDIT_PASSWORD_HASH=
